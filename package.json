{
  "name": "mazestreetwear",
  "version": "1.0.0",
  "description": "Minimalist streetwear WordPress theme for mazestw.in built with Tailwind CSS and WooCommerce",
  "main": "index.php",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/bundle.css --watch",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/bundle.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/bundle.css --minify",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/bundle.css --minify"
  },
  "keywords": [
    "wordpress",
    "theme",
    "streetwear",
    "minimalist",
    "woocommerce",
    "tailwindcss"
  ],
  "author": "MAZE (mazestw.in)",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
